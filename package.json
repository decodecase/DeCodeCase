{
  "name": "decodecase-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for the DecodeCase application.",
  "scripts": {
    "start-mobile": "NODE_OPTIONS=--openssl-legacy-provider npm run start --workspace=@decodecase/mobile",
    "build-case-engine": "npm run build --workspace=@decodecase/case-engine"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react-native-reanimated": "^3.17.5"
  },
  "devDependencies": {
    "@expo/webpack-config": "^19.0.1",
    "process": "^0.11.10",
    "webpack": "^5.99.8"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
