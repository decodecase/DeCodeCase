{
  "name": "decodecase-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for the DecodeCase application.",
  "scripts": {
    "start-mobile": "EXPO_USE_METRO_FOR_WEB=1 NODE_OPTIONS=--openssl-legacy-provider npm run start --workspace=@decodecase/mobile",
    "build-case-engine": "npm run build --workspace=@decodecase/case-engine"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "expo": "^53.0.9",
    "expo-crypto": "~14.1.4",
    "react-native-reanimated": "^3.17.5"
  },
  "devDependencies": {
    "process": "^0.11.10"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
